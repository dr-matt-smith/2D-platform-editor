[celbridge]
celbridge-version = "1.1.0"

# 'hide' keeps resources out of the Explorer tree. 'search-exclude' also keeps them out of search.
# Both take glob patterns, e.g. "Python/.venv/**".
[celbridge.resources]
hide = [".gitignore", ".DS_Store", "Thumbs.db", "desktop.ini", ".idea", ".pytest_cache"]
search-exclude = ["node_modules", "dist", "test-results", "playwright-report", "v4_preview", ".venv", "__pycache__", "deno.lock"]

[[shortcut]]
resource = "README.md"
icon = "bs-filetype-md"
area = "side"
open-on-load = true

[[shortcut]]
resource = "shell.console"
icon = "bs-terminal"
area = "bottom"
open-on-load = true

[[shortcut]]
resource = "dev-server.console"
icon = "bs-play-circle"
area = "bottom"
