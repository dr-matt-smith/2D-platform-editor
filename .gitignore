# Dependencies (Deno fills node_modules/ with the npm packages Vite and
# Playwright need, because deno.json sets "nodeModulesDir": "auto")
node_modules/

# Build output
dist/

# Vite dependency pre-bundle cache
.vite/

# Logs
*.log

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Celbridge project metadata (the *.celbridge project file stays tracked)
.celbridge/

# Claude Code local settings
.claude/settings.local.json

# Local v4 render previews (not committed)
v4_preview/

# Playwright (diagnostic runs; screenshots regenerated on demand)
playwright-report/
test-results/
tests/screenshots/
